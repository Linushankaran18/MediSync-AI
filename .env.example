# --- Database ---
DATABASE_URL=postgresql://medintel:medintel@localhost:5432/medintel

# --- Auth ---
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- LLM ---
# LLM_PROVIDER=ollama for local dev (needs `docker compose up ollama` or a
# local Ollama install), LLM_PROVIDER=cloud for the Render deployment (Groq).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
CLOUD_LLM_URL=https://api.groq.com/openai/v1
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=llama-3.3-70b-versatile

# --- Vision OCR (scanned/photographed image uploads: .png/.jpg/.jpeg) ---
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# --- Embeddings (local, free, no API key) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PATH=./chroma_data
CHROMA_COLLECTION=patient_documents

# --- Storage ---
UPLOAD_DIR=./uploads

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
